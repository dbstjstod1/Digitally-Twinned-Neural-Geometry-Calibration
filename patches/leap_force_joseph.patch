diff --git a/src/leapctype.py b/src/leapctype.py
index b81da84..d21f524 100644
--- a/src/leapctype.py
+++ b/src/leapctype.py
@@ -5736,6 +5736,31 @@
         self.set_model()
         return self.libprojectors.set_truncatedScan(aFlag)
         
+    def set_forceJosephModular(self, aFlag):
+        """Pin CUDA modular forward and backprojection to their Joseph branches.
+
+        Set True to disable the geometry-dependent separable-footprint branches.
+        This controls kernel selection; it does not imply exact adjointness.
+        """
+        self.libprojectors.set_forceJosephModular.argtypes = [ctypes.c_bool]
+        self.libprojectors.set_forceJosephModular.restype = ctypes.c_bool
+        self.set_model()
+        return self.libprojectors.set_forceJosephModular(aFlag)
+
+    def get_forceJosephModular(self):
+        """Return whether CUDA modular Joseph kernel selection is enabled."""
+        self.libprojectors.get_forceJosephModular.argtypes = []
+        self.libprojectors.get_forceJosephModular.restype = ctypes.c_bool
+        self.set_model()
+        return self.libprojectors.get_forceJosephModular()
+
+    def get_forceJosephModularBackprojection(self):
+        """Check that this library supports and enables the backprojection pin."""
+        self.libprojectors.get_forceJosephModularBackprojection.argtypes = []
+        self.libprojectors.get_forceJosephModularBackprojection.restype = ctypes.c_bool
+        self.set_model()
+        return self.libprojectors.get_forceJosephModularBackprojection()
+
