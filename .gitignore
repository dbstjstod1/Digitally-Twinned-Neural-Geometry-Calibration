# Public release allowlist. Local experiments and writing assets stay private.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/THIRD_PARTY_NOTICES.md
!/geocal/
!/examples/
!/patches/
!/tests/
/tests/*
!/tests/public/

# Generated data and runtime files are excluded within public directories too.
__pycache__/
*.py[cod]
*.egg-info/
*.raw
*.npy
*.npz
*.pt
*.pth
*.dat
*.log
.venv/
.pytest_cache/
